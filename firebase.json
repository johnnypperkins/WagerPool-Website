{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
        {
          "source": "/verify-password",
          "function": "app"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
  },
  "functions": [
    {
      "source": "websitefunctions",
      "codebase": "websitefunctions",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ]
}
